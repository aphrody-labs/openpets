{
  "name": "openpets-v2-workspace",
  "version": "4.1.0",
  "private": true,
  "description": "OpenPets 2.0 workspace",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenPetsHQ/openpets.git"
  },
  "type": "module",
  "packageManager": "bun@1.4.6",
  "engines": {
    "bun": ">=1.4.6"
  },
  "scripts": {
    "install:release": "bun install --frozen-lockfile --os=darwin --os=win32 --os=linux --cpu=x64 --cpu=arm64 --libc=glibc",
    "docs:dev": "blume dev",
    "docs:build": "blume build",
    "docs:preview": "blume preview",
    "docs:deploy": "bun run docs:build && bunx wrangler pages deploy dist --project-name openpets-docs --branch main --commit-dirty=true",
    "dev:desktop": "bun run --filter @open-pets/desktop dev",
    "dev:desktop:control-center": "bun run --filter @open-pets/desktop dev:control-center",
    "dev:desktop:plugins": "bun run --filter @open-pets/desktop dev:plugins",
    "capture": "bun scripts/capture.mjs",
    "dev:desktop:third-parties": "OPENPETS_DISABLE_PLUGIN_CATALOG=1 OPENPETS_DEV_PLUGIN_ROOTS=\"$(pwd)/third-parties\" bun run dev:desktop",
    "package:desktop:dir": "bun run build && bun run --filter @open-pets/desktop package:dir",
    "package:desktop": "bun run build && bun run --filter @open-pets/desktop package",
    "release:desktop": "bun apps/desktop/scripts/release-local.mjs",
    "release:npm": "bun scripts/release-npm.mjs",
    "vscode:check": "bun run --filter '*' build && bun run --filter openpets-vscode build && bun run --filter openpets-vscode check && bun run --filter openpets-vscode test",
    "vscode:build": "bun run --filter '*' build && bun run --filter openpets-vscode build",
    "vscode:package": "bun run --filter '*' build && bun run --filter openpets-vscode package:local",
    "plugins:locales": "bun scripts/check-plugin-locales.mjs",
    "marketplace:validator:build": "bun scripts/build-marketplace-validator.mjs",
    "marketplace:validator:check": "bun scripts/build-marketplace-validator.mjs --check",
    "marketplace:validator:test": "bun test scripts/marketplace-validator.test.mjs",
    "marketplace:publish": "bun scripts/marketplace-publish.mjs",
    "plugins:test": "bun run plugins:locales && bun scripts/test-plugins.mjs",
    "plugins:check": "bun web/scripts/sync-plugins.js --dry-run --skip-r2",
    "plugins:validate-release": "bun scripts/validate-plugin-release.mjs",
    "plugins:validate-live": "bun scripts/validate-plugin-release.mjs --live",
    "plugins:package": "bun web/scripts/sync-plugins.js --skip-r2",
    "plugins:publish": "bun web/scripts/sync-plugins.js",
    "plugins:deploy": "bun run --cwd web deploy",
    "plugins:release": "bun run plugins:package && bun run plugins:validate-release && bun run plugins:publish && bun run plugins:deploy && bun run plugins:validate-live",
    "test": "bun run build && bun scripts/npm-workspace-release.test.mjs && bun scripts/npm-release-policy.test.mjs && bun scripts/release-npm-ref-orchestration.test.mjs && bun apps/desktop/scripts/npm-release-gate.test.mjs && bun run --filter '*' test",
    "check": "bun run --filter '*' check",
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter '*' build",
    "marketplace:migrate": "bun scripts/marketplace-migrate.mjs",
    "marketplace:release:check": "bun web/scripts/marketplace-release-check.mjs"
  },
  "devDependencies": {
    "@open-pets/plugin-sdk": "workspace:*",
    "blume": "^1.3.1",
    "esbuild": "0.28.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.120.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@google/genai",
    "@vscode/vsce-sign",
    "electron",
    "esbuild",
    "get-windows",
    "keytar",
    "koffi",
    "msgpackr-extract",
    "protobufjs",
    "sharp",
    "workerd"
  ]
}
