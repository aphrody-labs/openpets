{
  "name": "@open-pets/client",
  "version": "4.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenPetsHQ/openpets.git",
    "directory": "packages/client"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "bun run test:build && bun .test-dist/contracts/client-protocol.contract.js",
    "test:build": "tsc -p tsconfig.tests.json",
    "check": "bun run typecheck && bun run build && bun run test",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "smoke": "bun run build && bun dist/smoke.js",
    "smoke:status": "bun run smoke status",
    "smoke:react": "bun run smoke react",
    "smoke:say": "bun run smoke say",
    "smoke:invalid-token": "bun run smoke invalid-token"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3"
  }
}
