{
  "name": "@open-pets/desktop",
  "version": "4.1.0",
  "private": true,
  "description": "OpenPets tray-first desktop companion app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenPetsHQ/openpets.git",
    "directory": "apps/desktop"
  },
  "author": "OpenPets",
  "type": "module",
  "main": "dist/bootstrap.js",
  "scripts": {
    "dev": "bun run build && electron .",
    "dev:electron": "bun run build:main && electron .",
    "dev:control-center": "concurrently -k -n renderer,electron -c cyan,magenta \"bun run dev:renderer\" \"wait-on http://127.0.0.1:5173 && cross-env OPENPETS_RENDERER_URL=http://127.0.0.1:5173 bun run dev:electron\"",
    "dev:plugins": "cross-env OPENPETS_DISABLE_PLUGIN_CATALOG=1 OPENPETS_DEV_PLUGIN_ROOTS=../../plugins/official:../../plugins/dev bun run dev",
    "dev:debug": "OPENPETS_LOG_LEVEL=debug OPENPETS_LOG_CONSOLE=1 bun run dev",
    "package": "bun run package:preflight && bun run build && node scripts/clean-package-output.cjs && electron-builder",
    "package:dir": "bun run package:preflight && bun run build && node scripts/clean-package-output.cjs && electron-builder --dir && bun dist/check-packaging-contract.js --output",
    "test": "bun scripts/run-tests.mjs",
    "build:deps": "bun run --filter \"@open-pets/desktop^...\" build",
    "test:build": "bun run build:deps && tsc -p tsconfig.tests.json",
    "check": "bun run typecheck && bun run build && bun run test",
    "typecheck": "bun run build:deps && tsc --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "build:main": "bun run build:deps && tsc && bun run build:preload",
    "build:preload": "vite build --config vite.pet-preload.config.ts",
    "build:renderer": "vite build",
    "build:wayland-helper": "cargo build --release --manifest-path native/openpets-wayland-helper/Cargo.toml",
    "dev:renderer": "vite --host 127.0.0.1",
    "build": "bun run build:main && bun run build:renderer",
    "package:preflight": "node scripts/check-windows-symlink-privilege.cjs"
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "@open-pets/plugin-sdk": "workspace:*",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "2.10.3",
    "@electron/asar": "^3.4.1",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.10.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@open-pets/agent-events": "workspace:*",
    "@open-pets/claude": "workspace:*",
    "@open-pets/cli": "workspace:*",
    "@open-pets/cursor": "workspace:*",
    "@open-pets/devin": "workspace:*",
    "@open-pets/mcp": "workspace:*",
    "@open-pets/openclaw": "workspace:*",
    "@open-pets/opencode": "workspace:*",
    "@open-pets/pet-format": "workspace:*",
    "@open-pets/zed": "workspace:*",
    "get-windows": "^9.3.0",
    "install-pet": "workspace:*",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.34.5",
    "undici": "^7.29.0",
    "x11": "4.2.1",
    "yauzl": "3.3.0"
  }
}
